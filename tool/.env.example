# Copy this file as .env and fill in the values.
# The plugin reads it from the directory ProM is launched from (or from HOME).
# Alternatives: environment variables, or -Dllm.api.key=... etc. at startup.
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-model-here
LLM_API_URL=https://api-endpoint/path
LLM_API_VERSION_HEADER=version-header-name
LLM_API_VERSION=version-value
